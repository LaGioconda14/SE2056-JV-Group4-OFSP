<%@page pageEncoding="UTF-8"%>
<div class="sticky bottom-0 z-30 overflow-hidden rounded-2xl border border-outline-variant/30 bg-surface-container-lowest/95 shadow-[0_-10px_35px_rgba(15,23,42,0.14)] backdrop-blur-xl">
    <div class="flex flex-col gap-4 px-5 py-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-wrap items-center gap-5 text-sm"><label class="flex cursor-pointer items-center gap-2"><input checked type="checkbox" data-select-all class="select-all-toggle h-4 w-4 accent-primary">Chọn tất cả</label><a href="<c:out value='${productsUrl}'/>" class="text-primary hover:underline">Tiếp tục mua hàng</a><span data-selected-summary-count aria-live="polite">Đã chọn: <strong><c:out value="${cart.items.size()}"/>/<c:out value="${cart.items.size()}"/> món</strong></span></div>
        <div class="flex items-center justify-between gap-5 lg:justify-end">
            <div class="text-right"><div class="text-xs text-on-surface-variant">Tổng tiền hàng (<span id="items-count-text"><c:out value="${cart.items.size()}"/> món</span>)</div><strong id="summary-total" class="text-2xl text-tertiary"><fmt:formatNumber value="${cart.totalAmount}" type="currency" currencyCode="VND" maxFractionDigits="0"/></strong><div class="text-xs text-on-surface-variant">Voucher được chọn ở bước thanh toán</div></div>
            <button type="button" data-cart-action="checkout" id="btn-checkout" class="inline-flex min-w-[180px] items-center justify-center gap-2 rounded-xl bg-tertiary px-6 py-3 font-bold text-white shadow-lg transition hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-50"><span id="btn-checkout-label">Mua hàng (<c:out value="${cart.items.size()}"/>)</span><span class="material-symbols-outlined text-[18px]">arrow_forward</span></button>
        </div>
    </div>
</div>
<form id="checkout-form" method="post" action="<c:out value='${checkoutUrl}'/>" class="hidden"><c:if test="${not empty sessionScope.cartCsrfToken}"><input type="hidden" name="csrfToken" value="${sessionScope.cartCsrfToken}"></c:if><input type="hidden" name="couponCode" id="checkout-form-coupon" value=""><input type="hidden" name="replaceShopCoupons" value="true"><div id="checkout-form-items"></div></form>
