<dialog id="variant-dialog-${item.cartItemID}" data-variant-dialog data-item-id="${item.cartItemID}" aria-labelledby="variant-title-${item.cartItemID}" class="w-[min(520px,calc(100%-24px))] rounded-2xl border border-outline-variant/40 p-0 shadow-2xl backdrop:bg-black/40">
    <form method="post" action="<c:out value='${changeVariantUrl}'/>" class="p-5">
        <input type="hidden" name="cartItemId" value="${item.cartItemID}"><c:if test="${not empty sessionScope.cartCsrfToken}"><input type="hidden" name="csrfToken" value="${sessionScope.cartCsrfToken}"></c:if>
        <div class="mb-4 flex items-start justify-between"><div><h3 id="variant-title-${item.cartItemID}" class="text-lg font-bold">Chọn phân loại hàng</h3><p class="text-sm text-on-surface-variant"><c:out value="${item.variant.product.name}"/></p></div><button type="button" data-cart-action="close-variant" data-item-id="${item.cartItemID}" aria-label="Đóng chọn phân loại"><span class="material-symbols-outlined">close</span></button></div>
        <div class="flex max-h-[55vh] flex-col gap-2 overflow-y-auto">
            <label class="flex items-center gap-3 rounded-xl border-2 ${available ? 'border-primary bg-primary/5' : 'opacity-50'} p-3"><input type="radio" name="variantId" value="${item.variant.variantId}" <c:if test="${available}">checked</c:if> <c:if test="${not available}">disabled</c:if> required><span class="flex-1"><strong class="block"><c:out value="${item.variant.variantName}"/></strong><small><fmt:formatNumber value="${item.variant.price}" type="currency" currencyCode="VND" maxFractionDigits="0"/> · Kho <c:out value="${item.variant.stockQuantity}"/></small></span><span class="text-xs font-bold text-primary">Đang chọn</span></label>
            <c:forEach var="alternative" items="${item.alternativeVariants}"><c:set var="alternativeAvailable" value="${alternative.active and alternative.stockQuantity > 0}"/><label class="flex items-center gap-3 rounded-xl border border-outline-variant/40 p-3 ${alternativeAvailable ? 'cursor-pointer hover:border-primary' : 'opacity-50'}"><input type="radio" name="variantId" value="${alternative.variantId}" <c:if test="${not alternativeAvailable}">disabled</c:if> required><span class="flex-1"><strong class="block"><c:out value="${alternative.variantName}"/><c:if test="${not empty alternative.unit}">, <c:out value="${alternative.unit}"/></c:if></strong><small><fmt:formatNumber value="${alternative.price}" type="currency" currencyCode="VND" maxFractionDigits="0"/> · Kho <c:out value="${alternative.stockQuantity}"/></small></span></label></c:forEach>
        </div>
        <div class="mt-5 flex justify-end gap-2"><button type="button" data-cart-action="close-variant" data-item-id="${item.cartItemID}" class="rounded-xl border px-4 py-2">Trở lại</button><button type="submit" class="rounded-xl bg-primary px-4 py-2 font-bold text-white">Xác nhận</button></div>
    </form>
</dialog>
