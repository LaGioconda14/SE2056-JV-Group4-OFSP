<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<fmt:setLocale value="vi_VN"/><c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard quản trị toàn sàn</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script><link rel="stylesheet" href="${ctx}/assets/css/admin.css?v=10"><link rel="stylesheet" href="${ctx}/assets/css/admin-dashboard.css?v=2"></head>
<body class="admin-body"><div class="admin-wrapper"><jsp:include page="layout/sidebar.jsp"><jsp:param name="activePage" value="dashboard"/></jsp:include><div class="admin-main"><jsp:include page="layout/header.jsp"/>
<main class="admin-page-content admin-dashboard-page">
<c:if test="${empty selectedShop and not stats.dataAvailable}"><div class="alert alert-warning"><c:out value="${stats.errorMessage}"/></div></c:if>
<section class="dashboard-heading"><div><div class="dashboard-breadcrumb">E-Commerce Admin <i class="bi bi-chevron-right"></i> Tổng quan</div><h1><c:choose><c:when test="${not empty selectedShop}">Phân tích: <c:out value="${selectedShop.shopName}"/></c:when><c:otherwise>Tổng quan hoạt động toàn sàn</c:otherwise></c:choose></h1><p><c:out value="${rangeLabel}"/> · <fmt:formatDate value="${fromDate}" pattern="dd/MM/yyyy"/> – <fmt:formatDate value="${toDate}" pattern="dd/MM/yyyy"/></p></div>
<form method="get" action="${ctx}/admin/dashboard" class="shop-selector"><input type="hidden" name="range" value="${range}"><label>Xem dashboard</label><select name="shopId" onchange="this.form.submit()"><option value="">Toàn sàn</option><c:forEach items="${shops}" var="s"><option value="${s.shopId}" ${selectedShopId==s.shopId?'selected':''}><c:out value="${s.shopName}"/> (${s.status})</option></c:forEach></select></form></section>
<div class="range-row"><c:forEach items="${['7','30','90','365','all']}" var="r"><c:set var="txt" value="${r=='7'?'7 ngày':r=='30'?'30 ngày':r=='90'?'90 ngày':r=='365'?'12 tháng':'Tất cả'}"/><a class="range-pill ${range==r?'active':''}" href="${ctx}/admin/dashboard?range=${r}<c:if test='${not empty selectedShopId}'>&shopId=${selectedShopId}</c:if>">${txt}</a></c:forEach></div>

<c:choose><c:when test="${empty selectedShop}">
<div class="todo-grid"><a href="${ctx}/admin/shops?status=PENDING" class="todo-card"><i class="bi bi-shop amber"></i><span><b>${pendingShops}</b><small>Shop chờ duyệt</small></span></a><a href="${ctx}/admin/product-moderation" class="todo-card"><i class="bi bi-shield-exclamation red"></i><span><b>${pendingProducts}</b><small>Sản phẩm cần duyệt</small></span></a><a href="${ctx}/admin/orders" class="todo-card"><i class="bi bi-box-seam blue"></i><span><b>${pendingOrders}</b><small>Đơn đang vận hành</small></span></a><a href="${ctx}/admin/orders" class="todo-card"><i class="bi bi-exclamation-octagon violet"></i><span><b>${openDisputes}</b><small>Khiếu nại đang mở</small></span></a></div>
<div class="kpi-grid"><div class="kpi-card"><span>GMV toàn sàn</span><strong>${stats.totalGmvFullFormatted}</strong><small>${hasCompare?stats.gmvGrowthFormatted:'Doanh số toàn thời gian'}</small></div><div class="kpi-card"><span>Đơn hàng</span><strong>${stats.totalOrdersFormatted}</strong><small>${hasCompare?stats.orderGrowthFormatted:'Tổng đơn phát sinh'}</small></div><div class="kpi-card"><span>Người dùng</span><strong><fmt:formatNumber value="${stats.totalUsersCount}" pattern="#,#00"/></strong><small>${hasCompare?stats.userGrowth:'Tổng tài khoản'}${hasCompare?'% tăng trưởng':''}</small></div><div class="kpi-card"><span>Nhà bán hàng</span><strong>${stats.activeShopsCount}</strong><small>${hasCompare?stats.shopGrowth:'Shop hoạt động'}${hasCompare?'% tăng trưởng':''}</small></div></div>
</c:when><c:otherwise>
<div class="todo-grid"><a href="${ctx}/admin/orders" class="todo-card"><i class="bi bi-box-open amber"></i><span><b>${pendingOrders}</b><small>Đơn chờ xử lý</small></span></a><a href="${ctx}/admin/orders" class="todo-card"><i class="bi bi-truck blue"></i><span><b>${shippingOrders}</b><small>Đơn đang giao</small></span></a><a href="${ctx}/admin/products" class="todo-card"><i class="bi bi-exclamation-triangle red"></i><span><b>${lowStockCount}</b><small>SKU sắp hết</small></span></a><a href="${ctx}/admin/orders" class="todo-card"><i class="bi bi-chat-dots violet"></i><span><b>${openDisputes}</b><small>Khiếu nại</small></span></a></div>
<div class="kpi-grid"><div class="kpi-card"><span>Doanh thu shop</span><strong><fmt:formatNumber value="${shopRevenue}" pattern="#,#00"/> ₫</strong><small>${hasCompare?(revenueChange==null?'Mới':revenueChange):'Toàn thời gian'}${hasCompare&&revenueChange!=null?'% so kỳ trước':''}</small></div><div class="kpi-card"><span>Đơn hàng</span><strong>${shopOrders}</strong><small>${shopDelivered} đã giao · ${shopCancelled} hủy/hoàn</small></div><div class="kpi-card"><span>Sản phẩm đã bán</span><strong>${shopItemsSold}</strong><small>Sản lượng trong kỳ</small></div><div class="kpi-card"><span>Giá trị đơn TB</span><strong><fmt:formatNumber value="${shopAverageOrder}" pattern="#,#00"/> ₫</strong><small>Trên đơn đã giao</small></div></div>
</c:otherwise></c:choose>

<div class="chart-grid"><section class="dash-panel"><header><h2>${empty selectedShop?'Xu hướng GMV và hoa hồng':'Doanh thu và số đơn'}</h2><p>Dữ liệu giao dịch trong kỳ</p></header><div class="chart-box"><canvas id="trendChart"></canvas></div></section><section class="dash-panel"><header><h2>Trạng thái đơn hàng</h2><p>${empty selectedShop?'Đơn tổng toàn sàn':'Đơn con của shop'}</p></header><div class="chart-box status"><canvas id="statusChart"></canvas><div id="statusEmpty" class="empty d-none">Chưa có đơn trong kỳ</div></div></section></div>

<c:choose><c:when test="${empty selectedShop}"><div class="lower-grid"><section class="dash-panel"><header><h2>Top 5 sản phẩm bán chạy</h2><p>Đơn đã giao trong kỳ</p></header><div class="rank-list"><c:forEach items="${topProducts}" var="p" varStatus="loop"><div class="rank-row"><em>${loop.index+1}</em><div><b><c:out value="${p.productName}"/></b><small><c:out value="${p.shopName}"/></small></div><span><b>${p.revenueFormatted}</b><small>${p.soldFormatted}</small></span></div></c:forEach><c:if test="${empty topProducts}"><div class="empty">Chưa có sản phẩm đã giao</div></c:if></div></section><section class="dash-panel"><header><h2>Shop chờ duyệt</h2><p>Hồ sơ mới cần kiểm tra</p></header><div class="rank-list"><c:forEach items="${pendingShopsList}" var="s"><div class="rank-row"><em>${s.avatarAbbr}</em><div><b><c:out value="${s.shopName}"/></b><small><c:out value="${s.businessType}"/> · <c:out value="${s.province}"/></small></div><span><small>${s.createdAtFormatted}</small></span></div></c:forEach><c:if test="${empty pendingShopsList}"><div class="empty">Không có hồ sơ chờ duyệt</div></c:if></div></section></div></c:when>
<c:otherwise><div class="lower-grid"><section class="dash-panel"><header><h2>Sản phẩm bán chạy</h2><p>Top 5 của shop</p></header><div class="rank-list"><c:forEach items="${bestSellers}" var="p" varStatus="loop"><div class="rank-row"><em>${loop.index+1}</em><div><b><c:out value="${p.name}"/></b><small>${p.orders} đơn</small></div><span><b><fmt:formatNumber value="${p.revenue}" pattern="#,#00"/> ₫</b><small>${p.qty} sản phẩm</small></span></div></c:forEach></div></section><section class="dash-panel"><header><h2>Đơn gần đây</h2><p>Hoạt động mới nhất</p></header><div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Khách</th><th>Giá trị</th><th>Trạng thái</th></tr></thead><tbody><c:forEach items="${recentOrders}" var="o"><tr><td><b><c:out value="${o.subOrderCode}"/></b></td><td><c:out value="${o.customer}"/></td><td><fmt:formatNumber value="${o.total}" pattern="#,#00"/> ₫</td><td>${o.status}</td></tr></c:forEach></tbody></table></div></section></div><div class="mini-grid"><section class="dash-panel center"><h2>Đánh giá shop</h2><strong class="big">${ratingStats.avg} ★</strong><small>${ratingStats.total} đánh giá</small></section><section class="dash-panel"><h2>Tồn kho thấp</h2><div class="rank-list"><c:forEach items="${lowStockItems}" var="i"><div class="rank-row two"><div><b><c:out value="${i.name}"/></b><small><c:out value="${i.variant}"/></small></div><span><b>${i.stock}</b></span></div></c:forEach></div></section><section class="dash-panel center"><h2>Quyết toán gần nhất</h2><c:choose><c:when test="${not empty latestPayout}"><strong class="big"><fmt:formatNumber value="${latestPayout.net}" pattern="#,#00"/> ₫</strong><small>${latestPayout.cycle} · ${latestPayout.status}</small></c:when><c:otherwise><div class="empty">Chưa có kỳ quyết toán</div></c:otherwise></c:choose></section></div></c:otherwise></c:choose>
</main></div></div>
<script>window.adminDashboardData={shopMode:${not empty selectedShop?'true':'false'},trend:{labels:${empty trendLabelsJson?'[]':trendLabelsJson},primary:${empty trendPrimaryJson?'[]':trendPrimaryJson},secondary:${empty trendSecondaryJson?'[]':trendSecondaryJson}},status:{labels:${empty statusLabelsJson?'[]':statusLabelsJson},values:${empty statusValuesJson?'[]':statusValuesJson}}};</script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script><script src="${ctx}/assets/js/admin.js?v=13"></script><script src="${ctx}/assets/js/admin-dashboard.js?v=2"></script></body></html>
