<%@page contentType="text/html" pageEncoding="UTF-8"%>
<div class="rv-layer" data-layer aria-hidden="true"><div class="rv-dialog" role="dialog" aria-modal="true" aria-labelledby="rv-modal-title">
        <div class="rv-dialog-title"><div><div class="rv-eyebrow" style="color:#059669">GỐC VƯỜN · ĐÁNH GIÁ XÁC THỰC</div><h2 id="rv-modal-title" data-dialog-title>Viết đánh giá</h2><p class="rv-sub" data-dialog-caption></p></div><button type="button" class="rv-x" data-close aria-label="Đóng">×</button></div>
        <form data-form>
            <div><label class="rv-field">Đánh giá trải nghiệm</label><div class="rv-rate-select" data-rate role="group" aria-label="Chọn từ 1 đến 5 sao"></div></div>
            <div class="rv-review-form-block" data-comment-box><label class="rv-field" for="rv-comment">Nội dung</label><textarea data-comment id="rv-comment" class="rv-input" maxlength="2000" placeholder="Chia sẻ trải nghiệm về chất lượng, đóng gói và giao hàng..."></textarea><p class="rv-mini-note" style="margin-top:7px">Nói thật về trải nghiệm của bạn. Nội dung báo cáo cần tối thiểu 10 ký tự.</p></div>
            <div class="rv-review-form-block" data-file-box><label class="rv-field" for="rv-images">Hình ảnh thực tế (không bắt buộc)</label><label class="rv-upload" for="rv-images"><span class="rv-upload-icon">📷</span><strong>Thêm hình ảnh thực tế</strong><span> Tối đa 3 ảnh JPG/PNG, mỗi ảnh dưới 3MB</span><input type="file" id="rv-images" data-image-input accept="image/jpeg,image/png" multiple style="display:block;margin-top:10px;max-width:100%"></label></div>
            <div class="rv-modal-footer"><button class="rv-btn secondary" type="button" data-close>Hủy</button><button class="rv-btn" type="submit" data-submit>Gửi đánh giá</button></div>
        </form></div></div>
