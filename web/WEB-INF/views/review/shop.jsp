<%@page contentType="text/html" pageEncoding="UTF-8"%>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Phản hồi đánh giá • Gốc Vườn</title>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"><script src="https://cdn.tailwindcss.com"></script>
        <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/reviews.css"></head><body style="margin:0">
        <jsp:include page="/views/common/header.jsp"/>
        <div class="rv-root rv-app" data-mode="shop" data-ctx="${pageContext.request.contextPath}"><div class="rv-container">
                <nav class="rv-crumb"><a href="${pageContext.request.contextPath}/shop/products">Gian hàng</a><span>›</span><span>Phản hồi khách mua</span></nav>
                <section class="rv-hero rv-hero-shop"><div class="rv-hero-copy"><div class="rv-eyebrow"><span class="rv-dot"></span> SELLER CENTER • GỐC VƯỜN</div><h1>Lắng nghe khách hàng.<br><em>Vun trồng uy tín.</em></h1><p>Theo dõi đánh giá sản phẩm và phản hồi người mua bằng sự tận tâm từ nhà vườn.</p><div class="rv-hero-points"><span>✓ Phản hồi trực tiếp</span><span>✓ Bảo vệ uy tín gian hàng</span></div></div><div class="rv-hero-art" aria-hidden="true"><span class="rv-fruit rv-fruit-a">🍊</span><span class="rv-fruit rv-fruit-b">🍎</span><span class="rv-fruit rv-fruit-c">🍐</span><span class="rv-fruit-leaf">✦</span></div></section>
                <section class="rv-stat-grid"><div class="rv-stat"><div class="rv-stat-icon">💬</div><div><strong data-stat-reviewed>–</strong><span>Đánh giá đang hiển thị</span></div></div><div class="rv-stat"><div class="rv-stat-icon">✓</div><div><strong>24/7</strong><span>Tiếp nhận phản hồi</span></div></div><div class="rv-stat"><div class="rv-stat-icon">⚑</div><div><strong>5 <small>★</small></strong><span>Chất lượng dịch vụ</span></div></div></section>
                <section class="rv-surface"><div class="rv-surface-header"><div><h2>Phản hồi từ khách hàng</h2><p class="rv-sub">Chỉ hiển thị đánh giá thuộc gian hàng do tài khoản này sở hữu</p></div><span class="rv-pill green">Nhà vườn</span></div>
                    <div class="rv-tabs"><button type="button" class="rv-tab" data-type="PRODUCT" aria-selected="true">🍎 Đánh giá sản phẩm</button><button type="button" class="rv-tab" data-type="SHOP" aria-selected="false">🌿 Đánh giá gian hàng</button></div>
                    <div class="rv-card-list" data-list></div><div class="rv-pagination"><button class="rv-btn secondary" data-prev>← Trước</button><span data-page>Trang 1</span><button class="rv-btn secondary" data-next>Sau →</button></div></section>
                <div class="rv-message" data-message role="status" aria-live="polite"></div><jsp:include page="dialog.jsp"/>
            </div></div><script src="${pageContext.request.contextPath}/assets/js/reviews.js"></script></body></html>
