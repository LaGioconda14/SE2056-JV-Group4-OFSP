<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">
    <display-name>Online Fruit Shopping Platform</display-name>
    <!-- Filters -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/change-password</url-pattern>
        <url-pattern>/profile</url-pattern>
    </filter-mapping>
    <!-- Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.auth.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>controller.auth.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>LoginGoogleServlet</servlet-name>
        <servlet-class>controller.auth.LoginGoogleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginGoogleServlet</servlet-name>
        <url-pattern>/login-google</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.auth.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>controller.auth.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <servlet-class>controller.auth.ResetPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <url-pattern>/reset-password</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ChangePasswordServlet</servlet-name>
        <servlet-class>controller.auth.ChangePasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChangePasswordServlet</servlet-name>
        <url-pattern>/change-password</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>controller.auth.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>


    <!-- Admin Servlets -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>controller.admin.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminOrderServlet</servlet-name>
        <servlet-class>controller.admin.AdminOrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminOrderServlet</servlet-name>
        <url-pattern>/admin/orders</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminProductServlet</servlet-name>
        <servlet-class>controller.admin.AdminProductServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminProductServlet</servlet-name>
        <url-pattern>/admin/products</url-pattern>
        <url-pattern>/admin/product-moderation</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminCategoryServlet</servlet-name>
        <servlet-class>controller.admin.AdminCategoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminCategoryServlet</servlet-name>
        <url-pattern>/admin/categories</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminUserServlet</servlet-name>
        <servlet-class>controller.admin.AdminUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUserServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminShopServlet</servlet-name>
        <servlet-class>controller.admin.AdminShopServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminShopServlet</servlet-name>
        <url-pattern>/admin/shops</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminVoucherServlet</servlet-name>
        <servlet-class>controller.admin.AdminVoucherServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminVoucherServlet</servlet-name>
        <url-pattern>/admin/vouchers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminDisputeServlet</servlet-name>
        <servlet-class>controller.admin.AdminDisputeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDisputeServlet</servlet-name>
        <url-pattern>/admin/disputes</url-pattern>
    </servlet-mapping>
        <!-- Shop Management Servlets -->
    <servlet>
        <servlet-name>ShopProductServlet</servlet-name>
        <servlet-class>controller.shop.ShopProductServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShopProductServlet</servlet-name>
        <url-pattern>/shop/products</url-pattern>
        <url-pattern>/shop</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ShopAddProductServlet</servlet-name>
        <servlet-class>controller.shop.ShopAddProductServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShopAddProductServlet</servlet-name>
        <url-pattern>/shop/product/add</url-pattern>
        <url-pattern>/shop/products/add</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ShopInventoryServlet</servlet-name>
        <servlet-class>controller.shop.ShopInventoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShopInventoryServlet</servlet-name>
        <url-pattern>/shop/inventory</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ShopEditProductServlet</servlet-name>
        <servlet-class>controller.shop.ShopEditProductServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShopEditProductServlet</servlet-name>
        <url-pattern>/shop/product/edit</url-pattern>
        <url-pattern>/shop/products/edit</url-pattern>
        <url-pattern>/shop/product/toggle</url-pattern>
        <url-pattern>/shop/product/delete</url-pattern>
    </servlet-mapping>

    <!-- Shop Storefront / Trang Chủ Shop Servlets -->
    <servlet>
        <servlet-name>ShopStorefrontServlet</servlet-name>
        <servlet-class>controller.shop.ShopStorefrontServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShopStorefrontServlet</servlet-name>
        <url-pattern>/store</url-pattern>
        <url-pattern>/shop/storefront</url-pattern>
        <url-pattern>/shop/view</url-pattern>
        <url-pattern>/shop/home</url-pattern>
        <url-pattern>/shop-detail</url-pattern>
    </servlet-mapping>

    <!-- Product Browsing Servlets -->
    <servlet>
        <servlet-name>ProductDetailServlet</servlet-name>
        <servlet-class>controller.product.ProductDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductDetailServlet</servlet-name>
        <url-pattern>/detail</url-pattern>
        <url-pattern>/product/detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProductCatalogServlet</servlet-name>
        <servlet-class>controller.product.ProductCatalogServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductCatalogServlet</servlet-name>
        <url-pattern>/products</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration (30 minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>