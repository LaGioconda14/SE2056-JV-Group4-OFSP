-- 3.12. Quản lý kho hàng, lô sản phẩm & Hạn sử dụng (Inventory & Batches)
-- ============================================================

-- Bảng quản lý lô hàng và hạn sử dụng (Phục vụ bài toán hàng tươi sống)
CREATE TABLE [dbo].[product_batches] (
    [batch_id]          BIGINT IDENTITY(1,1) PRIMARY KEY,
    [batch_code]        VARCHAR(50) NOT NULL, -- Mã lô (VD: LOT-202610-01)
    [variant_id]        BIGINT NOT NULL,      -- Liên kết với biến thể sản phẩm
    [initial_quantity]  INT NOT NULL,         -- Số lượng lúc mới nhập về
    [current_quantity]  INT NOT NULL,         -- Số lượng hiện tại còn lại trong kho
    [expiry_date]       DATE NOT NULL,        -- Ngày hết hạn sử dụng
    [status]            VARCHAR(30) NOT NULL DEFAULT 'ACTIVE', -- ACTIVE, EXPIRED, DEPLETED
    [created_at]        DATETIME DEFAULT CURRENT_TIMESTAMP,
    [updated_at]        DATETIME DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT FK_batches_variant FOREIGN KEY ([variant_id]) REFERENCES [dbo].[product_variants]([variant_id]) ON DELETE CASCADE
);

-- Bảng lịch sử biến động kho (Inventory Transaction History - Log lại mọi thao tác Nhập/Xuất/Hủy)
CREATE TABLE [dbo].[inventory_transactions] (
    [transaction_id]    BIGINT IDENTITY(1,1) PRIMARY KEY,
    [batch_id]          BIGINT NULL,          -- Liên kết lô hàng (nếu có)
    [variant_id]        BIGINT NOT NULL,      -- Sản phẩm/biến thể chịu tác động
    [shop_id]           BIGINT NOT NULL,      -- Shop nào thực hiện
    [user_id]           BIGINT NOT NULL,      -- Ai là người thực hiện thao tác này
    [transaction_type]  VARCHAR(30) NOT NULL, -- RESTOCK (Nhập hàng), SALE (Bán hàng), MANUAL_ADJUST (Điều chỉnh/Hủy hàng hỏng)
    [quantity_changed]  INT NOT NULL,         -- Số lượng thay đổi (+ dương nếu nhập, - âm nếu xuất/hủy)
    [previous_stock]    INT NOT NULL,         -- Tồn kho trước khi đổi
    [new_stock]         INT NOT NULL,         -- Tồn kho sau khi đổi
    [reason]            NVARCHAR(255) NULL,   -- Lý do (VD: "Hủy 5kg táo bị dập nát")
    [created_at]        DATETIME DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT FK_inv_trans_batch FOREIGN KEY ([batch_id]) REFERENCES [dbo].[product_batches]([batch_id]) ON DELETE SET NULL,
    CONSTRAINT FK_inv_trans_variant FOREIGN KEY ([variant_id]) REFERENCES [dbo].[product_variants]([variant_id]),
    CONSTRAINT FK_inv_trans_shop FOREIGN KEY ([shop_id]) REFERENCES [dbo].[shops]([shop_id]),
    CONSTRAINT FK_inv_trans_user FOREIGN KEY ([user_id]) REFERENCES [dbo].[users]([user_id])
);

-- Tạo Index tối ưu tốc độ tra cứu kho và hạn sử dụng
CREATE INDEX IX_product_batches_expiry ON [dbo].[product_batches]([variant_id], [expiry_date]);
CREATE INDEX IX_inventory_transactions_shop ON [dbo].[inventory_transactions]([shop_id], [created_at] DESC);
GO

