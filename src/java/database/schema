GO

CREATE TABLE [dbo].[product_variants] (
    [variant_id]          BIGINT IDENTITY(1,1) NOT NULL,
    [product_id]          BIGINT NOT NULL,
    [sku]                 VARCHAR(50) NOT NULL,
    [variant_name]        NVARCHAR(100) NOT NULL,
    [unit]                NVARCHAR(30) NOT NULL DEFAULT N'kg',
