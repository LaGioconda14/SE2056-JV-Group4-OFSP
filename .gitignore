# NetBeans private user-specific settings (DO NOT COMMIT to avoid breaking team members' paths)
nbproject/private/

# VS Code local run scripts and tasks (keep local for VS Code users)
.vscode/tasks.json
.vscode/*.ps1


# Build and distribution directories
build/
dist/

# Local database scripts (keep local)
database.sql
*.sql

# Logs and temporary files
*.log
*.tmp

# Uploaded user avatars
web/assets/images/avatars/*
!web/assets/images/avatars/.gitkeep

docs/
.vscode/

# OAuth private credentials (keep secret)
*oauth.properties
!*oauth.properties.example
